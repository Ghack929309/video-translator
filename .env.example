# Copy from .env.example and fill in real values
# These are placeholders for local development

# Supabase
SUPABASE_URL="https://placeholder.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_placeholder"
SUPABASE_SECRET_KEY="sb_secret_placeholder"

# Database
DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder"
DIRECT_DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder"

# Tigris
TIGRIS_ACCESS_KEY_ID="placeholder"
TIGRIS_SECRET_ACCESS_KEY="placeholder"
TIGRIS_ENDPOINT_URL="https://fly.storage.tigris.dev"
TIGRIS_BUCKET_NAME="video-translator"
TIGRIS_REGION="auto"

# AssemblyAI
ASSEMBLYAI_API_KEY="placeholder"

# OpenAI
OPENAI_API_KEY="placeholder"

# Fish Audio
FISH_AUDIO_API_KEY="placeholder"

# CosyVoice (optional — only needed when using CosyVoice TTS engine)
COSYVOICE_URL=

# App
APP_URL="http://localhost:5173"
NODE_ENV="development"
